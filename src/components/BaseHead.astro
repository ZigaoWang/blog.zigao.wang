---
import { Analytics } from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';
import { AUTHOR, SITE_TITLE, SITE_URL } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	category?: string;
	tags?: string[];
	/** On book posts the frontmatter `author` is the book's author, not me. */
	bookAuthor?: string;
	rating?: number;
	lang?: string;
}

const {
	title,
	description,
	image,
	type = 'website',
	publishedTime,
	modifiedTime,
	category,
	tags,
	bookAuthor,
	rating,
	lang = 'en',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = image ? new URL(image, Astro.site).href : undefined;
const isArticle = type === 'article';

// One Person node, referenced by @id everywhere else, so search engines
// resolve every mention to the same entity instead of duplicates.
const person = {
	'@type': 'Person',
	'@id': `${SITE_URL}/#person`,
	name: AUTHOR.name,
	alternateName: AUTHOR.alternateName,
	jobTitle: AUTHOR.jobTitle,
	url: SITE_URL,
	sameAs: AUTHOR.sameAs,
};

const website = {
	'@type': 'WebSite',
	'@id': `${SITE_URL}/#website`,
	url: SITE_URL,
	name: SITE_TITLE,
	description,
	inLanguage: lang,
	publisher: { '@id': `${SITE_URL}/#person` },
};

const graph: Record<string, unknown>[] = [person, website];

if (isArticle) {
	graph.push({
		'@type': 'BlogPosting',
		'@id': `${canonicalURL.href}#article`,
		headline: title,
		description,
		...(imageURL && { image: imageURL }),
		...(publishedTime && { datePublished: publishedTime.toISOString() }),
		dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
		inLanguage: lang,
		author: { '@id': `${SITE_URL}/#person` },
		publisher: { '@id': `${SITE_URL}/#person` },
		mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
		...(category && { articleSection: category }),
		...(tags?.length && { keywords: tags.join(', ') }),
	});

	graph.push({
		'@type': 'BreadcrumbList',
		'@id': `${canonicalURL.href}#breadcrumb`,
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
			{ '@type': 'ListItem', position: 2, name: 'Posts', item: `${SITE_URL}/blog` },
			{ '@type': 'ListItem', position: 3, name: title },
		],
	});

	// Book posts carry a star rating, which is eligible for a review snippet.
	if (bookAuthor && rating) {
		graph.push({
			'@type': 'Review',
			'@id': `${canonicalURL.href}#review`,
			itemReviewed: {
				'@type': 'Book',
				name: title,
				author: { '@type': 'Person', name: bookAuthor },
			},
			reviewRating: {
				'@type': 'Rating',
				ratingValue: rating,
				bestRating: 5,
				worstRating: 1,
			},
			author: { '@id': `${SITE_URL}/#person` },
			...(publishedTime && { datePublished: publishedTime.toISOString().slice(0, 10) }),
		});
	}
} else {
	graph.push({
		'@type': 'WebPage',
		'@id': `${canonicalURL.href}#webpage`,
		url: canonicalURL.href,
		name: title,
		description,
		inLanguage: lang,
		isPartOf: { '@id': `${SITE_URL}/#website` },
		about: { '@id': `${SITE_URL}/#person` },
	});
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };

// og:locale wants underscores and a region (zh-CN -> zh_CN, en -> en_US).
const ogLocale = lang.includes('-')
	? lang.replace('-', '_')
	: { en: 'en_US', zh: 'zh_CN' }[lang] ?? lang;
---

{/* Global Metadata */}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

{/* Analytics (Umami) */}
<script defer src="https://cloud.umami.is/script.js" data-website-id="871a307e-509d-4fd9-8a34-306a385ad0f9"></script>

{/* Real-user Core Web Vitals (Vercel Speed Insights) */}
<SpeedInsights />

{/* Vercel Web Analytics */}
<Analytics />

{/* Fonts are self-hosted (see global.css). Preload only the faces that
     render above the fold; the rest load on demand via @font-face. */}
<link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/newsreader-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/ZigaoHand-Regular.woff2" as="font" type="font/woff2" crossorigin />

{/* Canonical URL */}
<link rel="canonical" href={canonicalURL} />

{/* Primary Meta Tags */}
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={AUTHOR.name} />

{/* Open Graph / Facebook */}
<meta property="og:type" content={isArticle ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{imageURL && <meta property="og:image" content={imageURL} />}
{imageURL && <meta property="og:image:alt" content={title} />}

{isArticle && publishedTime && (
	<meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{isArticle && modifiedTime && (
	<meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{isArticle && <meta property="article:author" content={AUTHOR.name} />}
{isArticle && category && <meta property="article:section" content={category} />}
{isArticle && tags?.map((tag) => <meta property="article:tag" content={tag} />)}

{/* Twitter */}
<meta property="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:creator" content="@zigaow" />
{imageURL && <meta property="twitter:image" content={imageURL} />}

{/* Structured data */}
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
